NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restaurantos?schema=public
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/restaurantos?schema=public

# Auth & Session Secrets (change in staging/production!)
JWT_ACCESS_SECRET=dev_access_secret_change_me_min_32_chars_long
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_min_32_chars_long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# CORS & Domain Config
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
PLATFORM_BASE_DOMAIN=restaurantos.app
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
