generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ============================================================================
// ENUMS
// ============================================================================

enum TenantStatus {
  PENDING_ONBOARDING
  ACTIVE
  SUSPENDED
  READ_ONLY
}

enum DomainType {
  SUBDOMAIN
  CUSTOM
}

enum DomainStatus {
  PENDING_VERIFICATION
  VERIFIED
  FAILED
  DISABLED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  GRACE_PERIOD
  PAST_DUE
  EXPIRED
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum PlanTier {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum StaffStatus {
  INVITED
  ACTIVE
  DEACTIVATED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  OUT_OF_SERVICE
}

enum TableSessionStatus {
  ACTIVE
  BILLING_PENDING
  CLOSED
}

enum DietaryType {
  VEG
  NON_VEG
  EGGETARIAN
  VEGAN
}

enum OrderStatus {
  PLACED
  ACCEPTED
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum BillType {
  INDIVIDUAL
  COMBINED
}

enum BillStatus {
  DRAFT
  APPROVED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  RAZORPAY_ONLINE
  CASH
  UPI_COUNTER
  CARD_COUNTER
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum ActorType {
  USER
  CUSTOMER
  SYSTEM
}

// ============================================================================
// 1. PLATFORM LEVEL TABLES
// ============================================================================

model PlatformSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(100)
  value       Json
  description String?  @db.VarChar(500)
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("platform_settings")
}

model SubscriptionPlan {
  id                      String   @id @default(uuid()) @db.Uuid
  code                    String   @unique @db.VarChar(50)
  name                    String   @db.VarChar(100)
  tier                    PlanTier
  description             String?  @db.Text
  monthlyPriceInr         Int      @map("monthly_price_inr") // in paise
  annualPriceInr          Int      @map("annual_price_inr") // in paise
  maxBranches             Int      @default(1) @map("max_branches")
  maxStaff                Int      @default(10) @map("max_staff")
  maxTables               Int      @default(25) @map("max_tables")
  customDomainEnabled     Boolean  @default(false) @map("custom_domain_enabled")
  advancedBrandingEnabled Boolean  @default(false) @map("advanced_branding_enabled")
  analyticsEnabled        Boolean  @default(true) @map("analytics_enabled")
  isActive                Boolean  @default(true) @map("is_active")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Restaurant {
  id                     String       @id @default(uuid()) @db.Uuid
  name                   String       @db.VarChar(150)
  slug                   String       @unique @db.VarChar(100)
  status                 TenantStatus @default(PENDING_ONBOARDING)
  onboardingStep         Int          @default(1) @map("onboarding_step")
  onboardingCompleted    Boolean      @default(false) @map("onboarding_completed")
  description            String?      @db.Text
  contactEmail           String       @map("contact_email") @db.VarChar(255)
  contactPhone           String?      @map("contact_phone") @db.VarChar(20)
  addressLine1           String?      @map("address_line1") @db.VarChar(255)
  city                   String?      @db.VarChar(100)
  state                  String?      @db.VarChar(100)
  country                String       @default("IN") @db.VarChar(2)
  postalCode             String?      @map("postal_code") @db.VarChar(20)
  timezone               String       @default("Asia/Kolkata") @db.VarChar(64)
  currency               String       @default("INR") @db.VarChar(3)
  gstin                  String?      @db.VarChar(20)
  fssaiLicense           String?      @map("fssai_license") @db.VarChar(30)

  // White-label branding
  logoUrl                String?      @map("logo_url") @db.VarChar(500)
  faviconUrl             String?      @map("favicon_url") @db.VarChar(500)
  primaryColor           String       @default("#0F172A") @map("primary_color") @db.VarChar(20)
  secondaryColor         String       @default("#334155") @map("secondary_color") @db.VarChar(20)
  backgroundColor        String       @default("#FFFFFF") @map("background_color") @db.VarChar(20)
  fontFamily             String       @default("Inter") @map("font_family") @db.VarChar(50)
  welcomeTitle           String?      @map("welcome_title") @db.VarChar(150)
  welcomeMessage         String?      @map("welcome_message") @db.Text
  menuLayout             String       @default("LIST") @map("menu_layout") @db.VarChar(30)
  socialLinks            Json?        @map("social_links")
  receiptFooterText      String?      @map("receipt_footer_text") @db.VarChar(500)

  // Operational & Merchant Payment Config (kept separate from RestaurantOS SaaS billing)
  guestBrowsingEnabled   Boolean      @default(true) @map("guest_browsing_enabled")
  allowConcurrentSessions Boolean     @default(false) @map("allow_concurrent_sessions")
  taxRateBps             Int          @default(500) @map("tax_rate_bps") // 5.00% = 500 bps
  serviceChargeBps       Int          @default(0) @map("service_charge_bps")
  razorpayMerchantId     String?      @map("razorpay_merchant_id") @db.VarChar(100)
  razorpayKeyId          String?      @map("razorpay_key_id") @db.VarChar(100)
  razorpayKeySecretEnc   String?      @map("razorpay_key_secret_enc") @db.Text

  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  domains                RestaurantDomain[]
  subscriptions          Subscription[]
  subscriptionInvoices   SubscriptionInvoice[]
  branches               Branch[]
  roles                  Role[]
  restaurantUsers        RestaurantUser[]
  tables                 RestaurantTable[]
  tableSessions          TableSession[]
  customers              Customer[]
  categories             Category[]
  products               Product[]
  carts                  Cart[]
  orders                 Order[]
  kitchenTickets         KitchenTicket[]
  bills                  Bill[]
  payments               Payment[]
  refunds                Refund[]
  feedbacks              Feedback[]
  feedbackTemplates      FeedbackTemplate[]
  notifications          Notification[]
  auditLogs              AuditLog[]
  fileUploads            FileUpload[]

  @@index([status])
  @@map("restaurants")
}

model RestaurantDomain {
  id                String       @id @default(uuid()) @db.Uuid
  restaurantId      String       @map("restaurant_id") @db.Uuid
  hostname          String       @unique @db.VarChar(255)
  domainType        DomainType   @map("domain_type")
  status            DomainStatus @default(PENDING_VERIFICATION)
  verificationToken String       @map("verification_token") @db.VarChar(128)
  isPrimary         Boolean      @default(false) @map("is_primary")
  isActive          Boolean      @default(false) @map("is_active")
  verifiedAt        DateTime?    @map("verified_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([hostname, isActive, status])
  @@map("restaurant_domains")
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  restaurantId       String             @map("restaurant_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus @default(TRIALING)
  billingCycle       BillingCycle       @default(MONTHLY) @map("billing_cycle")
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  gracePeriodEndsAt  DateTime?          @map("grace_period_ends_at")
  cancelledAt        DateTime?          @map("cancelled_at")
  razorpaySubId      String?            @map("razorpay_sub_id") @db.VarChar(100)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  restaurant Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  plan       SubscriptionPlan      @relation(fields: [planId], references: [id])
  invoices   SubscriptionInvoice[]

  @@index([restaurantId, status])
  @@map("subscriptions")
}

model SubscriptionInvoice {
  id                String   @id @default(uuid()) @db.Uuid
  restaurantId      String   @map("restaurant_id") @db.Uuid
  subscriptionId    String   @map("subscription_id") @db.Uuid
  invoiceNumber     String   @unique @map("invoice_number") @db.VarChar(50)
  amountInr         Int      @map("amount_inr")
  taxInr            Int      @default(0) @map("tax_inr")
  totalInr          Int      @map("total_inr")
  status            String   @db.VarChar(30) // PENDING, PAID, FAILED
  razorpayPaymentId String?  @map("razorpay_payment_id") @db.VarChar(100)
  paidAt            DateTime? @map("paid_at")
  createdAt         DateTime @default(now()) @map("created_at")

  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("subscription_invoices")
}

// ============================================================================
// 2. ORGANIZATION, USERS & RBAC
// ============================================================================

model Branch {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  name         String   @db.VarChar(150)
  code         String   @db.VarChar(30)
  phone        String?  @db.VarChar(20)
  addressLine1 String?  @map("address_line1") @db.VarChar(255)
  city         String?  @db.VarChar(100)
  state        String?  @db.VarChar(100)
  postalCode   String?  @map("postal_code") @db.VarChar(20)
  businessHours Json?   @map("business_hours")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant      Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantUsers RestaurantUser[]
  tables          RestaurantTable[]
  tableSessions   TableSession[]
  orders          Order[]
  bills           Bill[]

  @@unique([id, restaurantId])
  @@unique([restaurantId, code])
  @@index([restaurantId])
  @@map("branches")
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique @db.VarChar(255)
  phone         String?   @db.VarChar(20)
  fullName      String    @map("full_name") @db.VarChar(150)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  isSuperAdmin  Boolean   @default(false) @map("is_super_admin")
  emailVerified Boolean   @default(false) @map("email_verified")
  isActive      Boolean   @default(true) @map("is_active")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  sessions        UserSession[]
  restaurantUsers RestaurantUser[]

  @@map("users")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(128)
  userAgent        String?   @map("user_agent") @db.VarChar(500)
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model Role {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String?  @map("restaurant_id") @db.Uuid // NULL = global system role template
  code         String   @db.VarChar(50)
  name         String   @db.VarChar(100)
  description  String?  @db.VarChar(300)
  isSystem     Boolean  @default(false) @map("is_system")
  createdAt    DateTime @default(now()) @map("created_at")

  restaurant      Restaurant?      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  restaurantUsers RestaurantUser[]

  @@unique([restaurantId, code])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(100) // e.g., "orders:read", "billing:approve"
  module      String   @db.VarChar(50)
  description String?  @db.VarChar(300)
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RestaurantUser {
  id           String      @id @default(uuid()) @db.Uuid
  restaurantId String      @map("restaurant_id") @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  branchId     String?     @map("branch_id") @db.Uuid // NULL = all branches access
  roleId       String      @map("role_id") @db.Uuid
  status       StaffStatus @default(ACTIVE)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch     Branch?    @relation(fields: [branchId, restaurantId], references: [id, restaurantId])
  role       Role       @relation(fields: [roleId], references: [id])

  @@unique([restaurantId, userId])
  @@index([restaurantId, status])
  @@map("restaurant_users")
}

// ============================================================================
// 3. RESTAURANT OPERATIONS, TABLES & CUSTOMERS
// ============================================================================

model RestaurantTable {
  id           String      @id @default(uuid()) @db.Uuid
  restaurantId String      @map("restaurant_id") @db.Uuid
  branchId     String      @map("branch_id") @db.Uuid
  tableNumber  String      @map("table_number") @db.VarChar(30)
  capacity     Int         @default(4)
  qrToken      String      @unique @map("qr_token") @db.VarChar(128)
  status       TableStatus @default(AVAILABLE)
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch        Branch         @relation(fields: [branchId, restaurantId], references: [id, restaurantId], onDelete: Cascade)
  tableSessions TableSession[]

  @@unique([id, restaurantId])
  @@unique([branchId, tableNumber])
  @@index([restaurantId, branchId])
  @@map("restaurant_tables")
}

model Customer {
  id             String   @id @default(uuid()) @db.Uuid
  restaurantId   String   @map("restaurant_id") @db.Uuid
  phone          String   @db.VarChar(20)
  fullName       String?  @map("full_name") @db.VarChar(150)
  email          String?  @db.VarChar(255)
  phoneVerified  Boolean  @default(false) @map("phone_verified")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  restaurant    Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  sessions      CustomerSession[]
  tableJoins    TableSessionCustomer[]
  carts         Cart[]
  orders        Order[]
  bills         Bill[]
  payments      Payment[]
  feedbacks     Feedback[]

  @@unique([id, restaurantId])
  @@unique([restaurantId, phone])
  @@index([restaurantId])
  @@map("customers")
}

model CustomerSession {
  id               String    @id @default(uuid()) @db.Uuid
  restaurantId     String    @map("restaurant_id") @db.Uuid
  customerId       String    @map("customer_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(128)
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId, restaurantId], references: [id, restaurantId], onDelete: Cascade)

  @@index([restaurantId, customerId])
  @@map("customer_sessions")
}

model OtpVerification {
  id           String    @id @default(uuid()) @db.Uuid
  restaurantId String?   @map("restaurant_id") @db.Uuid
  target       String    @db.VarChar(255) // phone or email
  purpose      String    @db.VarChar(50)  // CUSTOMER_LOGIN, OWNER_VERIFY
  otpHash      String    @map("otp_hash") @db.VarChar(128)
  attempts     Int       @default(0)
  maxAttempts  Int       @default(5) @map("max_attempts")
  expiresAt    DateTime  @map("expires_at")
  verifiedAt   DateTime? @map("verified_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([target, purpose])
  @@map("otp_verifications")
}

model TableSession {
  id              String             @id @default(uuid()) @db.Uuid
  restaurantId    String             @map("restaurant_id") @db.Uuid
  branchId        String             @map("branch_id") @db.Uuid
  tableId         String             @map("table_id") @db.Uuid
  sessionCode     String             @map("session_code") @db.VarChar(30)
  status          TableSessionStatus @default(ACTIVE)
  orderingEnabled Boolean            @default(true) @map("ordering_enabled")
  openedAt        DateTime           @default(now()) @map("opened_at")
  closedAt        DateTime?          @map("closed_at")

  restaurant Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch                 @relation(fields: [branchId, restaurantId], references: [id, restaurantId])
  table      RestaurantTable        @relation(fields: [tableId, restaurantId], references: [id, restaurantId])
  customers  TableSessionCustomer[]
  carts      Cart[]
  orders     Order[]
  bills      Bill[]

  @@unique([id, restaurantId])
  @@index([restaurantId, tableId, status])
  @@map("table_sessions")
}

model TableSessionCustomer {
  id             String   @id @default(uuid()) @db.Uuid
  restaurantId   String   @map("restaurant_id") @db.Uuid
  tableSessionId String   @map("table_session_id") @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  joinedAt       DateTime @default(now()) @map("joined_at")

  tableSession TableSession @relation(fields: [tableSessionId, restaurantId], references: [id, restaurantId], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId, restaurantId], references: [id, restaurantId], onDelete: Cascade)

  @@unique([tableSessionId, customerId])
  @@map("table_session_customers")
}

// ============================================================================
// 4. MENU MANAGEMENT
// ============================================================================

model Category {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  name         String   @db.VarChar(120)
  description  String?  @db.VarChar(400)
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([id, restaurantId])
  @@index([restaurantId, sortOrder])
  @@map("categories")
}

model Product {
  id           String      @id @default(uuid()) @db.Uuid
  restaurantId String      @map("restaurant_id") @db.Uuid
  categoryId   String      @map("category_id") @db.Uuid
  name         String      @db.VarChar(150)
  description  String?     @db.Text
  imageUrl     String?     @map("image_url") @db.VarChar(500)
  basePriceInr Int         @map("base_price_inr") // paise
  dietaryType  DietaryType @default(VEG) @map("dietary_type")
  isAvailable  Boolean     @default(true) @map("is_available")
  sortOrder    Int         @default(0) @map("sort_order")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  restaurant Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   Category         @relation(fields: [categoryId, restaurantId], references: [id, restaurantId], onDelete: Cascade)
  variants   ProductVariant[]
  addons     ProductAddon[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([id, restaurantId])
  @@index([restaurantId, categoryId, isAvailable])
  @@map("products")
}

model ProductVariant {
  id            String   @id @default(uuid()) @db.Uuid
  restaurantId  String   @map("restaurant_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  name          String   @db.VarChar(100)
  priceDeltaInr Int      @default(0) @map("price_delta_inr")
  isAvailable   Boolean  @default(true) @map("is_available")
  createdAt     DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId, restaurantId], references: [id, restaurantId], onDelete: Cascade)

  @@index([restaurantId, productId])
  @@map("product_variants")
}

model ProductAddon {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  name         String   @db.VarChar(100)
  priceInr     Int      @map("price_inr")
  isAvailable  Boolean  @default(true) @map("is_available")
  createdAt    DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId, restaurantId], references: [id, restaurantId], onDelete: Cascade)

  @@index([restaurantId, productId])
  @@map("product_addons")
}

// ============================================================================
// 5. PERSISTENT CART & ORDERING
// ============================================================================

model Cart {
  id             String   @id @default(uuid()) @db.Uuid
  restaurantId   String   @map("restaurant_id") @db.Uuid
  tableSessionId String   @map("table_session_id") @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableSession TableSession @relation(fields: [tableSessionId, restaurantId], references: [id, restaurantId], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId, restaurantId], references: [id, restaurantId], onDelete: Cascade)
  items        CartItem[]

  @@unique([id, restaurantId])
  @@unique([tableSessionId, customerId])
  @@index([restaurantId, customerId])
  @@map("carts")
}

model CartItem {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  cartId       String   @map("cart_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  variantId    String?  @map("variant_id") @db.Uuid
  addonIds     Json?    @map("addon_ids")
  quantity     Int      @default(1)
  notes        String?  @db.VarChar(300)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  cart    Cart    @relation(fields: [cartId, restaurantId], references: [id, restaurantId], onDelete: Cascade)
  product Product @relation(fields: [productId, restaurantId], references: [id, restaurantId])

  @@index([cartId])
  @@map("cart_items")
}

model Order {
  id                  String      @id @default(uuid()) @db.Uuid
  restaurantId        String      @map("restaurant_id") @db.Uuid
  branchId            String      @map("branch_id") @db.Uuid
  tableSessionId      String      @map("table_session_id") @db.Uuid
  customerId          String      @map("customer_id") @db.Uuid
  orderNumber         String      @map("order_number") @db.VarChar(30)
  status              OrderStatus @default(PLACED)
  subtotalInr         Int         @map("subtotal_inr")
  taxInr              Int         @map("tax_inr")
  totalInr            Int         @map("total_inr")
  specialInstructions String?     @map("special_instructions") @db.Text
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  restaurant    Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch        Branch               @relation(fields: [branchId, restaurantId], references: [id, restaurantId])
  tableSession  TableSession         @relation(fields: [tableSessionId, restaurantId], references: [id, restaurantId])
  customer      Customer             @relation(fields: [customerId, restaurantId], references: [id, restaurantId])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  kitchenTicket KitchenTicket?
  billOrders    BillOrder[]
  feedbacks     Feedback[]

  @@unique([id, restaurantId])
  @@unique([restaurantId, orderNumber])
  @@index([restaurantId, branchId, status])
  @@map("orders")
}

model OrderItem {
  id               String  @id @default(uuid()) @db.Uuid
  restaurantId     String  @map("restaurant_id") @db.Uuid
  orderId          String  @map("order_id") @db.Uuid
  productId        String  @map("product_id") @db.Uuid
  productNameSnap  String  @map("product_name_snap") @db.VarChar(150)
  variantNameSnap  String? @map("variant_name_snap") @db.VarChar(100)
  addonsSnap       Json?   @map("addons_snap")
  unitPriceInrSnap Int     @map("unit_price_inr_snap")
  quantity         Int
  lineTotalInr     Int     @map("line_total_inr")
  notes            String? @db.VarChar(300)

  order   Order   @relation(fields: [orderId, restaurantId], references: [id, restaurantId], onDelete: Cascade)
  product Product @relation(fields: [productId, restaurantId], references: [id, restaurantId])

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id           String      @id @default(uuid()) @db.Uuid
  restaurantId String      @map("restaurant_id") @db.Uuid
  orderId      String      @map("order_id") @db.Uuid
  fromStatus   OrderStatus? @map("from_status")
  toStatus     OrderStatus @map("to_status")
  changedById  String?     @map("changed_by_id") @db.Uuid
  actorType    ActorType   @map("actor_type")
  reason       String?     @db.VarChar(300)
  createdAt    DateTime    @default(now()) @map("created_at")

  order Order @relation(fields: [orderId, restaurantId], references: [id, restaurantId], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

model KitchenTicket {
  id           String    @id @default(uuid()) @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  orderId      String    @unique @map("order_id") @db.Uuid
  ticketNumber String    @map("ticket_number") @db.VarChar(30)
  startedAt    DateTime? @map("started_at")
  readyAt      DateTime? @map("ready_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order      @relation(fields: [orderId, restaurantId], references: [id, restaurantId], onDelete: Cascade)

  @@unique([orderId, restaurantId])
  @@index([restaurantId])
  @@map("kitchen_tickets")
}

// ============================================================================
// 6. BILLING & PAYMENTS (RESTAURANT MERCHANT FLOW)
// ============================================================================

model Bill {
  id               String     @id @default(uuid()) @db.Uuid
  restaurantId     String     @map("restaurant_id") @db.Uuid
  branchId         String     @map("branch_id") @db.Uuid
  tableSessionId   String     @map("table_session_id") @db.Uuid
  customerId       String?    @map("customer_id") @db.Uuid
  invoiceNumber    String     @map("invoice_number") @db.VarChar(50)
  billType         BillType   @map("bill_type")
  status           BillStatus @default(DRAFT)
  subtotalInr      Int        @map("subtotal_inr")
  discountInr      Int        @default(0) @map("discount_inr")
  taxInr           Int        @map("tax_inr")
  serviceChargeInr Int        @default(0) @map("service_charge_inr")
  totalInr         Int        @map("total_inr")
  snapshotData     Json       @map("snapshot_data")
  approvedByUserId String?    @map("approved_by_user_id") @db.Uuid
  approvedAt       DateTime?  @map("approved_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId, restaurantId], references: [id, restaurantId])
  tableSession TableSession @relation(fields: [tableSessionId, restaurantId], references: [id, restaurantId])
  customer     Customer?    @relation(fields: [customerId, restaurantId], references: [id, restaurantId])
  billOrders   BillOrder[]
  payments     Payment[]

  @@unique([id, restaurantId])
  @@unique([restaurantId, invoiceNumber])
  @@index([restaurantId, status])
  @@map("bills")
}

model BillOrder {
  id           String @id @default(uuid()) @db.Uuid
  restaurantId String @map("restaurant_id") @db.Uuid
  billId       String @map("bill_id") @db.Uuid
  orderId      String @unique @map("order_id") @db.Uuid // Prevents duplicating orders across bills

  bill  Bill  @relation(fields: [billId, restaurantId], references: [id, restaurantId], onDelete: Cascade)
  order Order @relation(fields: [orderId, restaurantId], references: [id, restaurantId])

  @@index([billId])
  @@map("bill_orders")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  restaurantId      String        @map("restaurant_id") @db.Uuid
  billId            String        @map("bill_id") @db.Uuid
  customerId        String?       @map("customer_id") @db.Uuid
  method            PaymentMethod
  status            PaymentStatus @default(CREATED)
  amountInr         Int           @map("amount_inr")
  razorpayOrderId   String?       @unique @map("razorpay_order_id") @db.VarChar(100)
  razorpayPaymentId String?       @unique @map("razorpay_payment_id") @db.VarChar(100)
  idempotencyKey    String        @unique @map("idempotency_key") @db.VarChar(128)
  paidAt            DateTime?     @map("paid_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  restaurant Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  bill       Bill           @relation(fields: [billId, restaurantId], references: [id, restaurantId])
  customer   Customer?      @relation(fields: [customerId, restaurantId], references: [id, restaurantId])
  events     PaymentEvent[]
  refunds    Refund[]

  @@unique([id, restaurantId])
  @@index([restaurantId, billId])
  @@map("payments")
}

model PaymentEvent {
  id              String   @id @default(uuid()) @db.Uuid
  restaurantId    String   @map("restaurant_id") @db.Uuid
  paymentId       String   @map("payment_id") @db.Uuid
  razorpayEventId String   @unique @map("razorpay_event_id") @db.VarChar(128)
  eventType       String   @map("event_type") @db.VarChar(100)
  payload         Json
  processedAt     DateTime @default(now()) @map("processed_at")

  payment Payment @relation(fields: [paymentId, restaurantId], references: [id, restaurantId], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_events")
}

model Refund {
  id               String       @id @default(uuid()) @db.Uuid
  restaurantId     String       @map("restaurant_id") @db.Uuid
  paymentId        String       @map("payment_id") @db.Uuid
  amountInr        Int          @map("amount_inr")
  reason           String?      @db.VarChar(300)
  status           RefundStatus @default(PENDING)
  razorpayRefundId String?      @unique @map("razorpay_refund_id") @db.VarChar(100)
  createdAt        DateTime     @default(now()) @map("created_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  payment    Payment    @relation(fields: [paymentId, restaurantId], references: [id, restaurantId])

  @@index([restaurantId, paymentId])
  @@map("refunds")
}

// ============================================================================
// 7. FEEDBACK & OPERATIONS
// ============================================================================

model Feedback {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  customerId   String   @map("customer_id") @db.Uuid
  rating       Int
  comment      String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order      @relation(fields: [orderId, restaurantId], references: [id, restaurantId])
  customer   Customer   @relation(fields: [customerId, restaurantId], references: [id, restaurantId])

  @@unique([orderId, customerId])
  @@index([restaurantId, rating])
  @@map("feedback")
}

model FeedbackTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  ratingTier   Int      @map("rating_tier") // 1..5
  text         String   @db.VarChar(300)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, ratingTier])
  @@map("feedback_templates")
}

model Notification {
  id           String    @id @default(uuid()) @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  targetType   String    @map("target_type") @db.VarChar(30) // USER, CUSTOMER
  targetId     String    @map("target_id") @db.Uuid
  channel      String    @db.VarChar(30) // IN_APP, SMS, EMAIL
  title        String    @db.VarChar(150)
  body         String    @db.Text
  readAt       DateTime? @map("read_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, targetId])
  @@map("notifications")
}

model AuditLog {
  id           String    @id @default(uuid()) @db.Uuid
  restaurantId String?   @map("restaurant_id") @db.Uuid // NULL for platform-level events
  actorId      String?   @map("actor_id") @db.Uuid
  actorType    ActorType @map("actor_type")
  action       String    @db.VarChar(100)
  resourceType String    @map("resource_type") @db.VarChar(80)
  resourceId   String?   @map("resource_id") @db.Uuid
  metadata     Json?
  ipAddress    String?   @map("ip_address") @db.VarChar(64)
  createdAt    DateTime  @default(now()) @map("created_at")

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

model FileUpload {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  purpose      String   @db.VarChar(50) // LOGO, FAVICON, PRODUCT_IMAGE
  storageKey   String   @unique @map("storage_key") @db.VarChar(500)
  mimeType     String   @map("mime_type") @db.VarChar(100)
  sizeBytes    Int      @map("size_bytes")
  publicUrl    String   @map("public_url") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("file_uploads")
}
