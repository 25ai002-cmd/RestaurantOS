{
  "name": "restaurantos",
  "version": "1.0.0",
  "private": true,
  "description": "RestaurantOS — Multi-tenant White-label Restaurant Management SaaS",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node start-server.js",
    "start": "node start-server.js --prod",
    "build": "npm run build --workspace=apps/api && npm run build --workspace=apps/web",
    "test": "npm test --workspace=apps/api && npm test --workspace=apps/web",
    "db:generate": "npm run db:generate --workspace=apps/api",
    "db:migrate": "npm run db:migrate --workspace=apps/api",
    "db:seed": "npm run db:seed --workspace=apps/api"
  }
}
